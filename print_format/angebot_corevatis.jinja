{#- Angebot Corevatis (Aufgabe 4.3): Angebot nach DIN 5008 Form B für Handwerksbetriebe.
    Titel/Bauvorhaben, Vorbemerkung, Positionen nach Raum/Bauteil gruppiert (1.1, 1.2 …),
    Eventual-/Alternativpositionen gekennzeichnet und nicht in der Summe, Zusammenstellung,
    Summen, Garantiehinweis, Zahlungsbedingungen, Schlussformel mit Unterschriften.
    Daten über angebot_corevatis_daten(doc) (erpnext_druckformate/angebot_corevatis.py).
    Ausgabe: Texte immer mit „| e“, HTML-Felder (Vorbemerkung, Langtext, Bedingungen,
    Adressanzeige) nur über html_sicher (nh3, enge Allowlist) - nie roh.
    Layout und Seitenumbruch wie „Angebot“ (eine Tabellenzeile je Position, keine
    Block-Elemente in der Zeile - siehe print_formats.css). -#}
<style>
    .print-format {
        margin-left: 0mm;
        margin-right: 0mm;
        margin-top: 10mm;
        margin-bottom: 45mm;
        font-size: 10pt;
    }
    .print-format #subject { margin-bottom: 1em; }
    .print-format #subject .titel { font-size: 11pt; font-weight: bold; }
    .print-format .cv-block { margin-top: 0.8em; page-break-inside: avoid; }
    .print-format .cv-text { font-size: 8.5pt; }
    .print-format .cv-text p { margin: 0 0 0.4em 0; }
    .print-format .cv-block h4 { font-size: 10pt; font-weight: bold; margin: 0 0 0.3em 0; }
    .print-format .cv-vorbemerkung { margin-bottom: 1em; font-size: 9pt; }
    .print-format .cv-vorbemerkung p { margin: 0 0 0.4em 0; }
    .print-format table.cv-positionen th { text-align: left; }
    .print-format table.cv-positionen th.text-right { text-align: right; }
    .print-format table.cv-positionen td { vertical-align: top; padding: 2px 3px; }
    .print-format table.cv-positionen tr.position td { border-bottom: 0.5pt solid #ccc; }
    .print-format .gruppe-titel { font-weight: bold; text-decoration: underline; }
    .print-format .positionsart { font-style: italic; }
    .print-format tr.zwischensumme td { font-weight: bold; padding-bottom: 8px; }
    .print-format table.cv-summen { margin-top: 0.5em; page-break-inside: avoid; }
    .print-format table.cv-summen td { padding: 1px 3px; }
    .print-format table.cv-summen tr.brutto td { border-top: solid black 1px; border-bottom: double black 3px; font-weight: bold; }
    .print-format .unterschriften { width: 100%; margin-top: 0.6em; page-break-inside: avoid; }
    .print-format .unterschriften td { width: 50%; vertical-align: bottom; padding-right: 10mm; }
    .print-format .unterschrift-linie { border-top: 1px solid black; margin-top: 9mm; padding-top: 1mm; font-size: 8pt; }
    .print-format .schluss p { margin: 0; }
</style>

{%- set cv = angebot_corevatis_daten(doc) -%}
{%- set company = frappe.get_doc("Company", doc.company) -%}
{%- set cmp_addr = frappe.get_doc("Address", doc.company_address) if doc.company_address else None -%}
{%- set pay_addr = frappe.get_doc("Address", doc.customer_address) if doc.customer_address else None -%}
{%- set contact = frappe.get_doc("Contact", doc.contact_person) if doc.contact_person else None -%}

<!-- HEAD -->
<div id="header">
    <div class="letter-head">
        {{ letter_head }}
    </div>
</div>

<div class="contact-row">
    <div id="address">
        {% if cmp_addr %}
        <div id="sender">
            <p>{{ (cmp_addr.address_title or company.company_name) | e }} &#183; {{ (cmp_addr.address_line1 or "") | e }} &#183;
                {% if cmp_addr.address_line2 %}{{ cmp_addr.address_line2 | e }} <br>{% endif %}
                {{ (cmp_addr.pincode or "") | e }} {{ (cmp_addr.city or "") | e }}
                {% if pay_addr and (cmp_addr.country != pay_addr.country) -%}
                    &#183; {{ (cmp_addr.country or "") | upper | e }}
                {%- endif %}
            </p>
        </div>
        {% endif %}
        {{ (doc.customer_name or "") | e }}<br />
        {#- Ansprechpartner nur, wenn er nicht schon der Kunde ist (Privatkunde) #}
        {% if contact and ((contact.first_name or "") ~ " " ~ (contact.last_name or "")) | trim != (doc.customer_name or "") | trim %}
                {%- if contact.salutation -%}
                    {{ contact.salutation | e }}
                {%- endif %}
                {%- if contact.salutation in ["Hr.", "Herr"] %}n{% endif %}
                {{ (contact.first_name or "") | e }} {{ (contact.last_name or "") | e }}<br>
        {% endif %}
        {{ cv.anschrift }}
    </div>

    <div id="contact">
        <table class="w-100 text-small">
            <tr>
                <td>Angebot-Nr.:</td>
                <td class="text-right">{{ doc.name | e }}</td>
            </tr>
            <tr>
                <td>Datum:</td>
                <td class="text-right">{{ frappe.utils.formatdate(doc.transaction_date, "dd.MM.yyyy") }}</td>
            </tr>
            {% if cv.kundennummer %}
            <tr>
                <td>Kunden-Nr.:</td>
                <td class="text-right">{{ cv.kundennummer | e }}</td>
            </tr>
            {% endif %}
            {% if cv.ansprechpartner %}
            <tr>
                <td>Ansprechpartner:</td>
                <td class="text-right">{{ cv.ansprechpartner | e }}</td>
            </tr>
            {% endif %}
            {% if company.phone_no %}
            <tr>
                <td>Telefon:</td>
                <td class="text-right">{{ company.phone_no | e }}</td>
            </tr>
            {% endif %}
            {% if company.email %}
            <tr>
                <td>E-Mail:</td>
                <td class="text-right">{{ company.email | e }}</td>
            </tr>
            {% endif %}
            {% if doc.valid_till %}
            <tr>
                <td>Gültig bis:</td>
                <td class="text-right">{{ frappe.utils.formatdate(doc.valid_till, "dd.MM.yyyy") }}</td>
            </tr>
            {% endif %}
        </table>
    </div>
</div>

<div id="faltmarke-1" class="din-mark"></div>
<div id="lochmarke" class="din-mark"></div>
<div id="faltmarke-2" class="din-mark"></div>

<!-- CONTENT -->
<div id="text">
    <div id="subject">
        <div class="titel">{{ cv.titel | e }}</div>
        {% if cv.bauvorhaben %}<div>Bauvorhaben: {{ cv.bauvorhaben | e }}</div>{% endif %}
    </div>

    {% if cv.vorbemerkung | striptags | trim %}
    <div class="cv-vorbemerkung">{{ cv.vorbemerkung }}</div>
    {% endif %}

    <table class="w-100 text-small cv-positionen">
        <thead class="black-border">
            <tr>
                <th style="width: 6%">Pos.</th>
                <th style="width: 51%">Beschreibung</th>
                <th style="width: 9%" class="text-right">Menge</th>
                <th style="width: 6%">Einh.</th>
                <th style="width: 13%" class="text-right">Einzelpreis</th>
                <th style="width: 15%" class="text-right">Gesamtpreis</th>
            </tr>
        </thead>
        <tbody>
        {%- for g in cv.gruppen %}
            {%- for p in g.positionen %}
                {%- set n = p.row %}
                {%- set erste = loop.first and g.titel %}
                {#- Gruppentitel steht in der ersten Positionszeile: eine eigene Zeile könnte
                    allein unten auf der Seite stehen bleiben (Zeilen werden nicht getrennt). #}
                <tr class="position">
                    <td>{% if erste %}<span class="gruppe-titel">{{ g.nr }}</span><br>{% endif %}{{ p.nr }}</td>
                    <td>
                        {%- if erste %}<span class="gruppe-titel">{{ g.titel | e }}</span><br>{% endif -%}
                        <b>{{ (n.item_name or n.item_code or "") | e }}</b>
                        {%- if p.art %}<br><span class="positionsart">{{ p.art }} – nicht in der Angebotssumme enthalten</span>{% endif %}
                        <span class="position-text">
                        {%- if p.langtext %}
                            <br>{{ p.langtext }}
                        {%- endif %}
                        </span>
                    </td>
                    <td class="text-right">{% if erste %}<br>{% endif %}{{ n.get_formatted("qty") }}</td>
                    <td>{% if erste %}<br>{% endif %}{{ _(n.uom or "") | e }}</td>
                    <td class="text-right">{% if erste %}<br>{% endif %}{{ n.get_formatted("rate") }}</td>
                    <td class="text-right">{% if erste %}<br>{% endif %}
                        {%- if p.in_summe -%}
                            {{ n.get_formatted("amount") }}
                        {%- else -%}
                            ({{ n.get_formatted("amount") }})
                        {%- endif -%}
                    </td>
                </tr>
            {%- endfor %}
            {%- if cv.mit_gruppen %}
                <tr class="zwischensumme">
                    <td></td>
                    <td colspan="4">Summe {{ g.nr }} {{ g.titel | e }}</td>
                    <td class="text-right">{{ frappe.utils.fmt_money(g.summe, currency=doc.currency) }}</td>
                </tr>
            {%- endif %}
        {%- endfor %}
        </tbody>
    </table>

    {% if cv.mit_gruppen and cv.gruppen | length > 1 %}
    <div class="cv-block">
        <h4>Zusammenstellung</h4>
        <table class="w-100 text-small cv-summen">
            {% for g in cv.gruppen %}
            <tr>
                <td style="width: 6%">{{ g.nr }}</td>
                <td style="width: 79%">{{ g.titel | e }}</td>
                <td style="width: 15%" class="text-right">{{ frappe.utils.fmt_money(g.summe, currency=doc.currency) }}</td>
            </tr>
            {% endfor %}
        </table>
    </div>
    {% endif %}

    <table class="w-100 text-small cv-summen">
        {% if doc.discount_amount %}
        <tr>
            <td style="width: 85%">Summe der Positionen</td>
            <td style="width: 15%" class="text-right">{{ doc.get_formatted("total") }}</td>
        </tr>
        <tr>
            <td>Nachlass{% if doc.additional_discount_percentage %} {{ doc.get_formatted("additional_discount_percentage") }} %{% endif %}</td>
            <td class="text-right">− {{ doc.get_formatted("discount_amount") }}</td>
        </tr>
        {% endif %}
        <tr>
            <td style="width: 85%"><b>Nettosumme</b></td>
            <td style="width: 15%" class="text-right"><b>{{ doc.get_formatted("net_total") }}</b></td>
        </tr>
        {% if doc.tax_category == "Reverse Charge" %}
        <tr>
            <td>Steuerschuldnerschaft des Leistungsempfängers (§ 13b UStG)</td>
            <td></td>
        </tr>
        {% else %}
            {% for tax_row in doc.taxes %}
                {% if tax_row.tax_amount or print_settings.print_taxes_with_zero_amount %}
                <tr>
                    <td>{{ (tax_row.description or tax_row.account_head or "") | e }}</td>
                    <td class="text-right">{{ tax_row.get_formatted("tax_amount") }}</td>
                </tr>
                {% endif %}
            {% endfor %}
            {% if doc.tax_exemption_reason %}
            <tr>
                <td>{{ _(doc.tax_exemption_reason) | e }}</td>
                <td></td>
            </tr>
            {% endif %}
        {% endif %}
        <tr class="brutto">
            <td>Angebotssumme brutto</td>
            <td class="text-right">{{ doc.get_formatted("grand_total") }}</td>
        </tr>
    </table>

    {% if cv.ausserhalb_summe %}
    <p class="text-small"><i>Eventual- und Alternativpositionen (Gesamtpreis in Klammern) sind nicht in der
        Angebotssumme enthalten. Sie werden nur nach gesonderter Beauftragung ausgeführt und abgerechnet.</i></p>
    {% endif %}

    {% if cv.garantiehinweis %}
    <div class="cv-block cv-text">
        <h4>Hinweise zur Gewährleistung</h4>
        <div>{{ cv.garantiehinweis }}</div>
    </div>
    {% endif %}

    {% if cv.bedingungen | striptags | trim %}
    <div class="cv-block cv-text">
        <h4>Zahlungsbedingungen und Gültigkeit</h4>
        {{ cv.bedingungen }}
    </div>
    {% endif %}

    <p style="margin-top: 0.8em;">Wir würden uns freuen, den Auftrag ausführen zu dürfen. Für Rückfragen stehen
        wir Ihnen gern zur Verfügung.</p>
    <div class="cv-block schluss">
        <table class="unterschriften">
            <tr>
                <td>
                    Mit freundlichen Grüßen<br>
                    {{ company.company_name | e }}
                    <div class="unterschrift-linie">{{ (cv.ansprechpartner or "Unterschrift Auftragnehmer") | e }}</div>
                </td>
                <td>
                    Auftrag erteilt:
                    <div class="unterschrift-linie">Ort, Datum, Unterschrift Auftraggeber</div>
                </td>
            </tr>
        </table>
    </div>
</div>

<!-- FOOTER -->
<div id="footer-html" class="visible-pdf">
    <div class="letter-head-footer">
        <p id="pagenum">
            Seite <span class="page"></span> von <span class="topage"></span>
        </p>
        <div class="print-format-footer">
            {{ footer }}
        </div>
    </div>
</div>
